# Local demo: no model key is necessary. Never commit .env.
AUTOQA_DATABASE_URL=sqlite:///./data/autoqa.db
AUTOQA_DATA_DIR=./data
AUTOQA_ARTIFACT_DIR=./artifacts
AUTOQA_ALLOWED_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
AUTOQA_RESOURCE_ORIGINS=
AUTOQA_HEADLESS=true
AUTOQA_CONCURRENCY=2
# Optional: protect API, reports and evidence. UI asks for this token.
AUTOQA_API_TOKEN=
# Use any OpenAI-compatible chat/completions service for arbitrary natural-language plans.
AUTOQA_LLM_BASE_URL=https://api.openai.com/v1
AUTOQA_LLM_API_KEY=
AUTOQA_LLM_MODEL=
# Optional. MCP attaches to the SAME browser through CDP, rather than a separate browser.
AUTOQA_MCP_ENABLED=false
AUTOQA_MCP_COMMAND=npx.cmd
AUTOQA_MCP_ARGS=["-y","chrome-devtools-mcp@1.10.1","--no-usage-statistics"]
# Optional external Langfuse instance, SDK reads these standard variables.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
