# Copy to .env. Secrets belong only in .env or deployment environment variables.
AUTOQA_ENV=development
HOST=0.0.0.0
PORT=8765
# Explicit product mode. Use a NEW database when switching from demo to production.
AUTOQA_MODE=demo
# Production master encryption key (not a model API key):
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AUTOQA_SECRET_KEY=
AUTOQA_ALLOW_PRIVATE_TARGETS=false
DEMO_MODE=true
DEMO_DAILY_LIMIT=20
DEMO_IP_LIMIT=3
DEMO_LLM_ENABLED=false
# Omit AUTOQA_SEED_DEMO to initialize empty public Demo databases automatically.
DATABASE_URL=sqlite:///./data/autoqa.db
# mysql+pymysql://user:URL_ENCODED_PASSWORD@host:3306/database?charset=utf8mb4
AUTOQA_DATA_DIR=./data
AUTOQA_ARTIFACT_DIR=./artifacts
AUTOQA_PUBLIC_BASE_URL=
AUTOQA_ALLOWED_ORIGINS=
AUTOQA_RESOURCE_ORIGINS=
AUTOQA_HEADLESS=true
AUTOQA_CONCURRENCY=2
AUTOQA_API_TOKEN=
# compatible preserves the original offline/browser behavior.
# mock generates plans without network/model credentials; execution is still real.
# Legacy development settings only. AUTOQA_MODE=production ignores ALL keys below.
# Production users configure their own Provider through the Model Service screen.
LLM_PROVIDER=compatible
LLM_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Legacy compatible provider settings remain supported.
AUTOQA_LLM_BASE_URL=https://api.openai.com/v1
AUTOQA_LLM_API_KEY=
AUTOQA_LLM_MODEL=
# Login API fixture fault. true => wrong password is deliberately accepted.
AUTOQA_DEMO_LOGIN_FAULT=true
# Docker MySQL: set these locally; there is no hardcoded password fallback.
MYSQL_DATABASE=autoqa
MYSQL_USER=autoqa
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
AUTOQA_MCP_ENABLED=false
AUTOQA_MCP_COMMAND=npx.cmd
AUTOQA_MCP_ARGS=["-y","chrome-devtools-mcp@1.10.1","--no-usage-statistics"]
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
